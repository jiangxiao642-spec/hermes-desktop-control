#!/usr/bin/env python3
"""SOM 点击——按元素编号点击（从 som-scan 缓存读坐标）。

用法:
  som-click <N>               # 左键点击元素 N
  som-click <N> --right       # 右键点击
  som-click <N> --double      # 双击
  som-click <N> --move        # 仅移动不点击
  som-click --list            # 列出所有缓存元素
"""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    from click_script import click_script
except ImportError:
    from scripts.click_script import click_script

_SOM_DIR = Path(os.environ.get("HERMES_TEMP", tempfile.gettempdir())) / "hermes-som"
CACHE_PATH = _SOM_DIR / "som-cache.json"

_MARKERS = {
    "click": "CLICK_OK",
    "right-click": "RIGHT_CLICK_OK",
    "double-click": "DOUBLE_CLICK_OK",
    "move": "MOVE_OK",
}

_LABELS = {
    "click": "点击",
    "right-click": "右键",
    "double-click": "双击",
    "move": "移动",
}


def die(msg):
    print(f"[som-click] ❌ {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    if not CACHE_PATH.exists():
        die("没有 SOM 缓存——先跑 som-scan")

    cache = json.loads(CACHE_PATH.read_text())
    elements = {el["index"]: el for el in cache["elements"]}

    if "--list" in sys.argv or "-l" in sys.argv:
        print(f"🔍 {len(elements)} 个可交互元素（缓存 {cache['screenshot']}）:\n")
        for el in cache["elements"]:
            print(f"  [{el['index']:>2}] {el['type']:<10} \"{el['label']}\"  "
                  f"→ ({el['cx']},{el['cy']})")
        return

    if len(sys.argv) < 2:
        print("用法: som-click <编号> [--right|--double|--move] [--list]", file=sys.stderr)
        sys.exit(1)

    try:
        idx = int(sys.argv[1])
    except ValueError:
        die(f"无效编号: {sys.argv[1]}")

    el = elements.get(idx)
    if el is None:
        die(f"元素 [{idx}] 不存在——som-scan 缓存里最大编号是 {max(elements.keys())}")

    x, y = el["cx"], el["cy"]

    if "--right" in sys.argv:
        action = "right-click"
    elif "--double" in sys.argv:
        action = "double-click"
    elif "--move" in sys.argv:
        action = "move"
    else:
        action = "click"

    script = click_script(action, x, y, ok_marker=_MARKERS[action])
    result = subprocess.run(
        ["ps-run", script], capture_output=True, text=True, timeout=10
    )
    print(f"[som-click] ✅ {_LABELS[action]} [{idx}] \"{el['label']}\" → ({x}, {y})")
    if result.stdout.strip():
        print(f"  {result.stdout.strip()}")


if __name__ == "__main__":
    main()
