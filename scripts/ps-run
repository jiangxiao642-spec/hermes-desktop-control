#!/usr/bin/env bash
# ps-run — PowerShell bridge, UTF-8 encoding enforced
# Usage: ps-run <powershell_commands>
#   or: echo "commands" | ps-run
set -e

SCRIPT="${1:-$(cat)}"

powershell.exe -NoProfile -Command "
[Console]::OutputEncoding = [Text.Encoding]::UTF8
[Console]::InputEncoding  = [Text.Encoding]::UTF8
${SCRIPT}
" 2>&1
